{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "images": {
    "sizes": [320, 640, 960, 1280, 1600, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 86400,
    "localPatterns": [{ "pathname": "^/uploads/.*$" }]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/((?!admin/).*)",
      "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false },
    { "source": "/en", "destination": "/#/en", "permanent": false },
    { "source": "/en/:path*", "destination": "/#/en/:path*", "permanent": false },
    { "source": "/:section(about|departments|services|doctors|facilities|news|booking|contact)", "destination": "/#/:section", "permanent": false },
    { "source": "/:section(about|departments|services|doctors|facilities|news|booking|contact)/:slug*", "destination": "/#/:section/:slug*", "permanent": false }
  ]
}
